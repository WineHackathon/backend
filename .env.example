# ==============================================================================
# Переменные окружения платформы «Своё Вино» & AI-Сомелье
# Скопируйте в .env: cp .env.example .env
# ==============================================================================

# LLM & AI Sommelier (OpenRouter)
LLM_API_KEY=your_openrouter_api_key_here
LLM_MODEL_NAME=meta-llama/llama-3.3-70b-instruct
LLM_API_BASE_URL=https://openrouter.ai/api/v1

# База данных PostgreSQL 16
POSTGRES_USER=wine_admin
POSTGRES_PASSWORD=change_this_in_production
POSTGRES_DB=wine_db
POSTGRES_PORT_HOST=5982

# Кэш и очереди Redis 7
REDIS_HOST=redis
REDIS_PORT=6379

# Безопасность и JWT авторизация
JWT_SECRET_KEY=wine_hackathon_super_secret_jwt_key_32_chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
MAX_USER_SESSIONS=5

# S3 Хранилище (FirstVDS / AWS S3 совместимое)
S3_ENDPOINT_URL=https://s3.firstvds.ru:443
S3_AWS_ACCESS_KEY_ID=
S3_AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=wine-hack
S3_REGION_NAME=ru-central-1

# Пейволл и лимиты для гостей (без авторизации)
ANON_SCAN_LIMIT=5
ANON_SCAN_TTL_SECONDS=86400

# ML Recognition API Configuration (H100 / Tuna Ingress)
ML_API_URL=https://akcizny-sbor.ru.tuna.am
ML_API_TOKEN=your_ml_api_token_here
ML_API_TIMEOUT=12.0
ML_MOCK_MODE=false
ML_FALLBACK_TO_MOCK=true

# Порты шлюза
GATEWAY_PORT=8080

